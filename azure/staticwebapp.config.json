{
  "routes": [
    {
      "route": "/*",
      "condition": {
        "host": ["receitasdoandre.com.br"]
      },
      "redirect": "https://www.receitasdoandre.com.br/:splat",
      "statusCode": 301
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "platform": {
    "apiRuntime": "node:18"
  },
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}